{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyber-butler.local/schemas/v1.7/quality-manifest.schema.json",
  "title": "CBP quality manifest v1.7",
  "type": "object",
  "required": [
    "schema_version", "package_id", "producer_id", "version", "gate_status",
    "applicable_gate_count", "skip_count", "skip_ratio",
    "blocking_skip", "gates", "artifact_hashes", "artifact_repository",
    "release_body_hash", "body_hash_scope", "evidence_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "package_id": {
      "type": "string",
      "enum": ["cbs", "cbe", "cbp", "cbm", "cbc", "cbg"]
    },
    "producer_id": {"type": "string", "enum": ["cbe", "cbp"]},
    "version": {"type": "string", "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "gate_status": {
      "type": "string",
      "enum": ["PASS", "FAIL", "SKIPPED_INFRA", "PRECONDITION_FAIL"]
    },
    "applicable_gate_count": {"type": "integer", "minimum": 0},
    "skip_count": {"type": "integer", "minimum": 0},
    "skip_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "blocking_skip": {"type": "boolean"},
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["PASS", "FAIL", "SKIPPED"]},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "artifact_hashes": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "artifact_repository": {
      "type": "object",
      "required": ["repository", "run_id", "artifact_name"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "run_id": {"type": "string", "minLength": 1},
        "artifact_name": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "release_body_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "body_hash_scope": {"const": "base"},
    "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
