{
  "coverage_json": "coverage.json",
  "coverage_allowlist": "coverage_allowlist.json",
  "target_files": [
    "src/cbp/coverage_gate.py",
    "src/cbp/dependency_gate.py",
    "src/cbp/comment_gate.py",
    "src/cbp/docs_gate.py",
    "src/cbp/binary_gate.py",
    "src/cbp/claims_gate.py",
    "src/cbp/config.py"
  ],
  "policy_file": "src/cbp/coverage_gate.py",
  "coverage_threshold": 80,
  "policy_threshold": 80,
  "comment_files": [
    "src/cbp/config.py",
    "src/cbp/coverage_gate.py",
    "src/cbp/dependency_gate.py",
    "src/cbp/comment_gate.py",
    "src/cbp/docs_gate.py",
    "src/cbp/binary_gate.py",
    "src/cbp/claims_gate.py",
    "src/cbp/cli.py",
    "tools/audit_rule_sources.py",
    "tools/dogfood_manifest.py",
    "tools/verify_manifest_artifact.py",
    "src/cbp/encoding_gate.py"
  ],
  "enable_dependency": true,
  "enable_docs": true,
  "enable_binary": true,
  "enable_claims": true,
  "coverage_groups": [
    {
      "name": "cbp",
      "files": [
        "src/cbp/coverage_gate.py",
        "src/cbp/dependency_gate.py",
        "src/cbp/comment_gate.py",
        "src/cbp/docs_gate.py",
        "src/cbp/binary_gate.py",
        "src/cbp/claims_gate.py",
        "src/cbp/config.py",
        "src/cbp/cli.py",
        "src/cbp/encoding_gate.py",
        "src/cbp/custom_rules.py",
        "src/cbp/sarif.py",
        "src/cbp/readers.py",
        "src/cbp/upgrade_gate.py"
      ],
      "threshold": 80,
      "mode": "enforce"
    },
    {
      "name": "security_core",
      "files": [
        "src/cbp/coverage_gate.py",
        "src/cbp/dependency_gate.py",
        "src/cbp/comment_gate.py",
        "src/cbp/docs_gate.py",
        "src/cbp/binary_gate.py",
        "src/cbp/claims_gate.py",
        "src/cbp/config.py",
        "src/cbp/cli.py",
        "src/cbp/encoding_gate.py",
        "tools/audit_rule_sources.py",
        "src/cbp/custom_rules.py",
        "src/cbp/sarif.py",
        "src/cbp/readers.py",
        "src/cbp/upgrade_gate.py"
      ],
      "threshold": 90,
      "mode": "enforce"
    }
  ],
  "dependency_lock": "requirements-test.lock",
  "install_command": "install-test.sh",
  "docs_manifest": "docs/history-manifest.json",
  "binary_artifacts": "artifacts",
  "claims_manifest": "quality-manifest.json",
  "claims_notes": "docs/RELEASE_NOTES.generated.md",
  "enable_encoding": true,
  "release_body": "docs/RELEASE_BODY.md",
  "custom_rules": [
    {
      "id": "CBP-CUSTOM-CBP-MARKER",
      "name": "no_internal_marker",
      "pattern": "CBP_FORBIDDEN_MARKER",
      "match": "literal",
      "files": [
        "src/**/*.py"
      ],
      "message": "Internal forbidden marker found.",
      "severity": "warning",
      "mode": "warn"
    }
  ],
  "evidence_readers": {
    "python": {
      "suffixes": [
        ".py"
      ],
      "encoding": "utf-8"
    }
  },
  "schema_version": "0.1.7",
  "upgrade_fixtures": [
    "tests/fixtures/cbp_v0.1.0.json"
  ],
  "required_artifacts": [
    "action.yml",
    "pyproject.toml",
    "README.md"
  ],
  "coverage_ratchet": "coverage-ratchet.json"
}
