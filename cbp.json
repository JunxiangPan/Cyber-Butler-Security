{
  "coverage_json": "coverage.json",
  "coverage_allowlist": "coverage_allowlist.json",
  "target_files": [
    "tools/broker.py"
  ],
  "policy_file": "tools/broker_policy.py",
  "coverage_threshold": 80,
  "policy_threshold": 85,
  "comment_files": [
    "tools/broker.py",
    "tools/broker_policy.py"
  ],
  "dependency_lock": "requirements-runtime.lock",
  "install_command": "installer/lib/Installer.Core.ps1",
  "docs_manifest": "docs/history-manifest.json",
  "binary_artifacts": "artifacts",
  "enable_claims": true,
  "claims_manifest": "quality-manifest.json",
  "claims_notes": "docs/releases/RELEASE_NOTES_v1.6.4.md",
  "coverage_groups": [
    {
      "name": "broker",
      "files": [
        "tools/broker.py"
      ],
      "threshold": 80,
      "mode": "enforce"
    },
    {
      "name": "policy",
      "files": [
        "tools/broker_policy.py"
      ],
      "threshold": 85,
      "mode": "enforce"
    },
    {
      "name": "security_core",
      "files": [
        "tools/verify_release.py",
        "tools/package_release.py",
        "tools/update_core.py",
        "installer/lib/totp_material.py",
        "tools/sanitize_for_release.py"
      ],
      "threshold": 0,
      "mode": "warn"
    },
    {
      "name": "auditors",
      "files": [
        "tools/audit_code_comments.py",
        "tools/audit_docs_consistency.py",
        "tools/privacy_scan.py",
        "tools/red_team_pentest.py"
      ],
      "threshold": 0,
      "mode": "warn"
    },
    {
      "name": "webui",
      "files": [
        "webui/**/*.py"
      ],
      "threshold": 0,
      "mode": "warn"
    }
  ],
  "enable_encoding": true,
  "schema_version": "0.1.4",
  "custom_rules": [
    {
      "id": "CBP-CUSTOM-NO-RAW-PYTHON",
      "name": "no_raw_python",
      "pattern": "(?m)(?<![\\/\\w-])(?:&\\s*|Start-Process\\s+-FilePath\\s+['\"]?|Get-Command\\s+['\"]?)python(?:\\.exe)?",
      "files": [
        "installer/lib/Installer.Core.ps1",
        "webui/start-services.ps1"
      ],
      "message": "Use $InstallRoot\\python\\python.exe, never a bare python command.",
      "mode": "enforce",
      "severity": "error"
    },
    {
      "id": "CBP-CUSTOM-REQUIRE-BROKER-ASSERT",
      "name": "require_broker_assert",
      "pattern": "HARD ASSERT FAILED: tools/broker.py",
      "required_pattern": "HARD ASSERT FAILED: tools/broker.py",
      "files": [
        "installer/lib/Installer.Core.ps1"
      ],
      "message": "Installer must assert tools/broker.py exists.",
      "mode": "enforce",
      "severity": "error"
    },
    {
      "id": "CBP-CUSTOM-NO-WARNING-STATUS",
      "name": "no_warning_journal_status",
      "pattern": "(?m)-Status\\s+['\"]warning['\"]",
      "files": [
        "installer/**/*.ps1"
      ],
      "message": "Journal status warning is not in the ValidateSet; use in_progress/completed/failed.",
      "mode": "enforce",
      "severity": "error"
    }
  ]
}
