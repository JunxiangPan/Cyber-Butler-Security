<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Margin="18">
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
  </Grid.RowDefinitions>

  <StackPanel Grid.Row="0">
    <TextBlock x:Name="CmdTitle" Text="一键指令发送器" FontSize="22" FontWeight="SemiBold"/>
    <TextBlock x:Name="CmdSubtitle" Text="通过 AstrBot Open API 发送到苏瑾言的 QQ 私聊" Margin="0,6,0,0" Foreground="{DynamicResource MutedBrush}"/>
  </StackPanel>

  <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,14,0,0">
    <StackPanel>
      <TextBox x:Name="CmdBox" Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
        <Button x:Name="CmdSendButton" Content="发送" Width="110" Height="34"/>
        <Button x:Name="CmdMorningButton" Content="发早安" Width="100" Height="34" Margin="8,0,0,0"/>
        <Button x:Name="CmdLocalButton" Content="切本地模型" Width="120" Height="34" Margin="8,0,0,0"/>
        <Button x:Name="CmdTempButton" Content="查看温度" Width="100" Height="34" Margin="8,0,0,0"/>
      </StackPanel>
    </StackPanel>
  </Border>

  <TextBlock Grid.Row="2" x:Name="CmdStatus" Margin="2,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>

  <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,14,0,0" VerticalAlignment="Top">
    <TextBlock x:Name="CmdHint" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
               Text="提示：发送走 AstrBot Open API，消息会出现在苏瑾言的 QQ 私聊里；不会在本机执行任何 shell 命令。"/>
  </Border>
</Grid>
