<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Margin="18">
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
  </Grid.RowDefinitions>

  <StackPanel Grid.Row="0">
    <TextBlock x:Name="SysTitle" Text="实时监控" FontSize="22" FontWeight="SemiBold"/>
    <TextBlock x:Name="SysSubtitle" Text="每 3 秒读取 LibreHardwareMonitor" Margin="0,6,0,0" Foreground="{DynamicResource MutedBrush}"/>
  </StackPanel>

  <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,14,0,0">
    <StackPanel>
      <Grid Margin="0,0,0,6">
        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="CpuLabel" Grid.Column="0" Text="CPU 温度" VerticalAlignment="Center"/>
        <ProgressBar x:Name="CpuBar" Grid.Column="1" Height="18" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center"/>
        <TextBlock x:Name="CpuValue" Grid.Column="2" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
      <Grid Margin="0,0,0,6">
        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="GpuLabel" Grid.Column="0" Text="GPU 温度" VerticalAlignment="Center"/>
        <ProgressBar x:Name="GpuBar" Grid.Column="1" Height="18" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center"/>
        <TextBlock x:Name="GpuValue" Grid.Column="2" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="VramLabel" Grid.Column="0" Text="显存占用" VerticalAlignment="Center"/>
        <ProgressBar x:Name="VramBar" Grid.Column="1" Height="18" Minimum="0" Maximum="24576" Value="0" VerticalAlignment="Center"/>
        <TextBlock x:Name="VramValue" Grid.Column="2" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
    </StackPanel>
  </Border>

  <TextBlock Grid.Row="2" x:Name="SysStatus" Margin="2,14,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
</Grid>
