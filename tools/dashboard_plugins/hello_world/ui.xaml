<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Margin="18">
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
  </Grid.RowDefinitions>

  <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1" CornerRadius="8" Padding="22">
    <StackPanel>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Hello World" FontSize="22" FontWeight="SemiBold"/>
        <Border Background="{DynamicResource TabSelectedBrush}" CornerRadius="10" Padding="8,2" Margin="10,3,0,0">
          <TextBlock x:Name="HelloBadge" Text="module" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
        </Border>
      </StackPanel>
      <TextBlock x:Name="HelloMeta" Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}"/>
      <TextBlock Text="这个页面不是主控台自带的。它由 tools\dashboard_plugins\hello_world 下的 ui.xaml 与 logic.ps1 在启动时动态加载。"
                 TextWrapping="Wrap" Margin="0,12,0,0" FontSize="14"/>
      <TextBlock Text="如果这个模块抛异常，主控台只会记录并提示，不会闪退。"
                 TextWrapping="Wrap" Margin="0,6,0,0" FontSize="13" Foreground="{DynamicResource MutedBrush}"/>

      <Border Background="{DynamicResource PageBrush}" BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,18,0,0">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="HelloButton" Content="点我 +1" Width="120" Height="34"/>
          <TextBlock x:Name="HelloCounter" Text="点击次数：0" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="16"/>
        </StackPanel>
      </Border>

      <TextBlock x:Name="HelloStatus" Margin="0,12,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
    </StackPanel>
  </Border>

  <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,14,0,0">
    <StackPanel>
      <TextBlock Text="模块契约" FontSize="17" FontWeight="SemiBold"/>
      <TextBlock Text="manifest.json：id / name / version / author / ui / logic / requires_dashboard"
                 Margin="0,10,0,0" TextWrapping="Wrap"/>
      <TextBlock Text="ui.xaml：一个可插入 TabItem 的根元素，可以使用主题 DynamicResource。"
                 Margin="0,6,0,0" TextWrapping="Wrap"/>
      <TextBlock Text="logic.ps1：可选；在独立作用域中运行，可定义 Initialize-DashboardModule($moduleContext)。"
                 Margin="0,6,0,0" TextWrapping="Wrap"/>
      <TextBlock Text="事件处理器必须捕获上下文（在处理器末尾加 .GetNewClosure()），否则模块加载结束后 $moduleContext 会变为空。"
                 Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}"/>
      <TextBlock Text="模块状态保存在 %LOCALAPPDATA%\CyberButler\dashboard-modules.json，禁用后不会加载 XAML 与脚本。"
                 Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
    </StackPanel>
  </Border>
</Grid>
