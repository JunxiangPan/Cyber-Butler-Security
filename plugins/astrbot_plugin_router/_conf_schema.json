{
  "owner_id": {
    "description": "Owner QQ id",
    "type": "string",
    "default": ""
  },
  "local_provider_id": {
    "description": "Local provider id",
    "type": "string",
    "default": "local_qwen36"
  },
  "cloud_provider_id": {
    "description": "Cloud provider id",
    "type": "string",
    "default": "deepseek"
  },
  "token_dpapi_path": {
    "description": "DPAPI token path",
    "type": "string",
    "default": "C:\\ProgramData\\CyberButler\\secrets\\router_signal.token.dpapi"
  },
  "vram_low_threshold_mb": {
    "description": "Free VRAM threshold for local routing",
    "type": "int",
    "default": 1000
  },
  "vram_debounce_count": {
    "description": "Consecutive low/high samples required before switching",
    "type": "int",
    "default": 3
  },
  "vram_sample_interval_seconds": {
    "description": "Minimum seconds between nvidia-smi samples",
    "type": "int",
    "default": 15
  }
